# Skopiuj ten plik do .env.local i uzupełnij wartości.
# .env.local jest ignorowany przez git — sekrety nie trafią do repozytorium.

# Klucz dostępu Web3Forms (wysyłka formularza kontaktowego).
# Wygeneruj na https://web3forms.com (podaj swój e-mail, klucz przyjdzie na skrzynkę).
# Prefiks NEXT_PUBLIC_ jest wymagany — Web3Forms (plan darmowy) wysyła z przeglądarki.
# Klucz nie trafia do repo, ale jest widoczny w kodzie klienta (dla Web3Forms to norma).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
