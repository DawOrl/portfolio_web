# Skopiuj ten plik do .env.local i uzupełnij wartości.
# .env.local jest ignorowany przez git — sekrety nie trafią do repozytorium.

# Klucz dostępu Web3Forms (wysyłka formularza kontaktowego).
# Wygeneruj na https://web3forms.com (podaj swój e-mail, klucz przyjdzie na skrzynkę).
# Prefiks NEXT_PUBLIC_ jest wymagany — Web3Forms (plan darmowy) wysyła z przeglądarki.
# Klucz nie trafia do repo, ale jest widoczny w kodzie klienta (dla Web3Forms to norma).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Własny szablon przez istniejącą skrzynkę OVH + darmowy Cloudflare Turnstile.
# Tryb SMTP włącza się po ustawieniu wszystkich czterech wymaganych wartości.
# Do tego czasu formularz korzysta z Web3Forms. Po zmianach wykonaj Redeploy.
SMTP_HOST=smtp.mail.ovh.net
SMTP_USER=contact@dorlowski.dev
# Hasło skrzynki. TYLKO po stronie serwera, bez prefiksu NEXT_PUBLIC_.
SMTP_PASSWORD=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://dorlowski.dev

# Prywatny panel /panel — Supabase (instrukcja: docs/dashboard-setup.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sekret serwera: legacy service_role lub nowy secret key. Nigdy NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# UUID ręcznie utworzonego konta w Authentication > Users.
DASHBOARD_ADMIN_USER_ID=
